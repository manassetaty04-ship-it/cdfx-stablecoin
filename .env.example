# Copiez ce fichier en ".env" (sans .example) et remplissez-le. NE JAMAIS publier ".env" sur GitHub.

# Clé privée du portefeuille DÉDIÉ au projet (MetaMask > Détails du compte > Afficher la clé privée).
# Utilisez un portefeuille neuf qui ne contient que des ETH de test Sepolia.
DEPLOYER_PRIVATE_KEY=

# RPC Sepolia. Valeur par défaut gratuite (sans clé) ; vous pouvez la remplacer par une URL Alchemy ou Infura.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Clé API Etherscan (gratuite) pour vérifier le code source des contrats.
ETHERSCAN_API_KEY=
